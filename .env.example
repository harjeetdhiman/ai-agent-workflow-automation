# =====================================================================
# AI Agent Workflow Automation System - Environment Configuration
# =====================================================================

# LLM Provider Configuration
# Options: 'auto' (default: uses OpenAI if key provided, else Mock), 'openai', or 'mock'
LLM_PROVIDER=auto

# OpenAI API Key (Optional for offline testing; required only for live LLM routing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Authoritative Excel Workflow File Path
EXCEL_WORKFLOW_FILE=data/AI_Agent_Workflow_Assessment (1).xlsx

# Business Decision Thresholds
DEFAULT_RESTOCK_THRESHOLD=10
DEFAULT_PRICE_VARIANCE_THRESHOLD=0.10
DEFAULT_PERFORMANCE_FAILURE_THRESHOLD=0.10
DEFAULT_PERFORMANCE_LATENCY_THRESHOLD=5.0
DEFAULT_SIMILARITY_THRESHOLD=0.75
